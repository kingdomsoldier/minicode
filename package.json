{
  "name": "minicode",
  "version": "0.1.0",
  "description": "Editor de código móvil-first con sugerencias inteligentes y terminal integrada",
  "type": "module",
  "bin": {
    "minicode": "./bin/cli.js"
  },
  "main": "./server/index.js",
  "files": [
    "bin/",
    "server/",
    "public/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "rollup -c && node scripts/build-css.js",
    "watch:js": "rollup -c -w",
    "start": "NODE_ENV=production node server/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "chokidar": "^4.0.0",
    "codemirror": "^6.0.1",
    "express": "^4.19.0",
    "open": "^10.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "rollup": "^4.24.0",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "editor",
    "code",
    "mobile",
    "termux",
    "javascript",
    "codemirror",
    "ide",
    "repl"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  }
}
